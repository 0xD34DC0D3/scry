[Unit]
Description=scry
Documentation=https://github.com/0xD34DC0D3/scry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scry
Group=scry
EnvironmentFile=/etc/scry/scry.env
ExecStart=/usr/local/bin/scry serve
Restart=on-failure
RestartSec=2s

# The DB lives here; everything else is read-only to the service.
StateDirectory=scry
ReadWritePaths=/var/lib/scry

# The DB holds every user's subscriptions and reading history, so it stays
# private. systemd's defaults would create the state directory 0755 and the
# database (plus -wal/-shm) 0644, readable by the other service accounts on
# this box. Setting these here rather than by hand matters: StateDirectory=
# re-applies StateDirectoryMode on every start, so a manual chmod gets
# reverted.
UMask=0077
StateDirectoryMode=0700

# Hardening: scry is a single static binary that listens on a port, writes its
# SQLite file and makes outbound HTTPS. Lock down the rest.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

# Blast-radius reduction for code execution inside this process. It accepts
# TCP from Caddy on loopback (including Inngest Cloud's calls to
# /api/inngest). Outbound, it fetches feeds, calls voodoo and talks to Inngest
# Cloud over HTTPS, so INET/INET6 stay open and there is no egress filter here;
# which addresses feeds may reach is enforced in the app (private addresses
# refused). AF_UNIX is for journald. No raw/packet/netlink sockets.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Hide other processes from scry's /proc (does not hide scry from others).
ProtectProc=invisible
# ProtectClock also matters for correctness: a clock moved backwards would
# skew fetch schedules, backoff and the validity of voodoo's session cookies.
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
