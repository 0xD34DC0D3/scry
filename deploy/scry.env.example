# Production environment for scry, read by systemd (EnvironmentFile).
# On the server this lives at /etc/scry/scry.env (owned root, mode 0640,
# group scry). Copy this file there and adjust. It holds the Inngest keys.
# install.sh sources it as root, so keep it plain KEY=value, no quoting tricks.
SCRY_DB_PATH=/var/lib/scry/scry.db
SCRY_PORT=8081
# Interface the listener binds to. Caddy is the only intended client and
# proxies to 127.0.0.1, so keep this on loopback. Set to empty for all interfaces.
SCRY_BIND=127.0.0.1
# Placeholders: scry.example.com is scry's host, auth.example.com is voodoo's.
# Both must be https in production.
SCRY_BASE_URL=https://scry.example.com
SCRY_VOODOO_URL=https://auth.example.com
# The deadcode website, linked from the header and footer. Required (https)
# in production: the default is a localhost dev server.
SCRY_SITE_URL=https://example.com
SCRY_LOG_LEVEL=info
# SCRY_PROD defaults to true; leave it unset. It makes scry refuse non-https
# URLs and missing Inngest keys. Never set INNGEST_DEV here: prod refuses it.
#
# Inngest Cloud keys (app "scry"), from the Inngest dashboard.
INNGEST_SIGNING_KEY=signkey-prod-...
INNGEST_EVENT_KEY=
